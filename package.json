{
  "name": "clawai-coding-agent",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.13.0",
  "publisher": "clawai",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ihabkhaled/ClawAI-Coding-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/ihabkhaled/ClawAI-Coding-Agent/issues"
  },
  "homepage": "https://github.com/ihabkhaled/ClawAI-Coding-Agent#readme",
  "engines": {
    "vscode": "^1.98.0",
    "node": ">=22.13.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "coding-agent",
    "local-first",
    "ollama",
    "code-review",
    "clawai"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted%"
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "clawAI.connect",
        "title": "%command.connect%",
        "category": "ClawAI",
        "icon": "$(plug)"
      },
      {
        "command": "clawAI.logout",
        "title": "%command.logout%",
        "category": "ClawAI",
        "icon": "$(sign-out)"
      },
      {
        "command": "clawAI.openChat",
        "title": "%command.openChat%",
        "category": "ClawAI",
        "icon": {
          "light": "resources/claw-light.svg",
          "dark": "resources/claw-dark.svg"
        }
      },
      {
        "command": "clawAI.askSelection",
        "title": "%command.askSelection%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.askFile",
        "title": "%command.askFile%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.askWorkspace",
        "title": "%command.askWorkspace%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.compareModels",
        "title": "%command.compareModels%",
        "category": "ClawAI",
        "icon": "$(compare-changes)"
      },
      {
        "command": "clawAI.judgeResponses",
        "title": "%command.judgeResponses%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.generateCode",
        "title": "%command.generateCode%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.fixCode",
        "title": "%command.fixCode%",
        "category": "ClawAI",
        "icon": "$(wrench)"
      },
      {
        "command": "clawAI.reviewCode",
        "title": "%command.reviewCode%",
        "category": "ClawAI",
        "icon": "$(inspect)"
      },
      {
        "command": "clawAI.generateTests",
        "title": "%command.generateTests%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.generatePlan",
        "title": "%command.generatePlan%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.generateDocs",
        "title": "%command.generateDocs%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.auditWorkspace",
        "title": "%command.auditWorkspace%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.initializeWorkspace",
        "title": "%command.initializeWorkspace%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.openGlobalRules",
        "title": "%command.openGlobalRules%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.openGlobalSkills",
        "title": "%command.openGlobalSkills%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.refreshModels",
        "title": "%command.refreshModels%",
        "category": "ClawAI",
        "icon": "$(refresh)"
      },
      {
        "command": "clawAI.selectModel",
        "title": "%command.selectModel%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.cancel",
        "title": "%command.cancel%",
        "category": "ClawAI",
        "icon": "$(debug-stop)"
      },
      {
        "command": "clawAI.undoLastEdit",
        "title": "%command.undoLastEdit%",
        "category": "ClawAI",
        "icon": "$(discard)"
      },
      {
        "command": "clawAI.exportTranscript",
        "title": "%command.exportTranscript%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.showSessionRecap",
        "title": "%command.showSessionRecap%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.openConversationInNewWindow",
        "title": "%command.openConversationInNewWindow%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.compactConversation",
        "title": "%command.compactConversation%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.selectOutputStyle",
        "title": "%command.selectOutputStyle%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.toggleFocusView",
        "title": "%command.toggleFocusView%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.renameChat",
        "title": "%command.renameChat%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.archiveChat",
        "title": "%command.archiveChat%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.browseArchivedChats",
        "title": "%command.browseArchivedChats%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.reopenClosedChat",
        "title": "%command.reopenClosedChat%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.showUsage",
        "title": "%command.showUsage%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.searchRunHistory",
        "title": "%command.searchRunHistory%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.sendFeedback",
        "title": "%command.sendFeedback%",
        "category": "ClawAI"
      },
      {
        "command": "clawAI.showLogs",
        "title": "%command.showLogs%",
        "category": "ClawAI"
      }
    ],
    "configuration": {
      "title": "ClawAI",
      "properties": {
        "clawAI.backendUrl": {
          "type": "string",
          "default": "https://claw.local",
          "scope": "machine",
          "description": "%config.backendUrl%"
        },
        "clawAI.backendEnvironment": {
          "type": "string",
          "enum": [
            "LOCAL",
            "CLOUD",
            "CUSTOM"
          ],
          "default": "LOCAL",
          "scope": "machine",
          "description": "%config.backendEnvironment%"
        },
        "clawAI.backendCustomUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.backendCustomUrl%"
        },
        "clawAI.frontendEnvironment": {
          "type": "string",
          "enum": [
            "LOCAL",
            "CLOUD",
            "CUSTOM"
          ],
          "default": "LOCAL",
          "scope": "machine",
          "description": "%config.frontendEnvironment%"
        },
        "clawAI.frontendCustomUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.frontendCustomUrl%"
        },
        "clawAI.requestTimeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 300000,
          "scope": "machine",
          "description": "%config.requestTimeoutMs%"
        },
        "clawAI.routingMode": {
          "type": "string",
          "enum": [
            "AUTO",
            "MANUAL_MODEL"
          ],
          "default": "AUTO",
          "scope": "resource",
          "description": "%config.routingMode%"
        },
        "clawAI.agentMode": {
          "type": "string",
          "enum": [
            "AUTO",
            "PLAN"
          ],
          "default": "AUTO",
          "scope": "resource",
          "description": "%config.agentMode%"
        },
        "clawAI.hooks": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.hooks%",
          "items": {
            "type": "object",
            "required": [
              "event",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "event": {
                "type": "string",
                "enum": [
                  "run-start",
                  "run-end",
                  "before-tool",
                  "after-tool"
                ]
              },
              "command": {
                "type": "string"
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "toolGlob": {
                "type": "string"
              },
              "blocking": {
                "type": "boolean"
              }
            }
          }
        },
        "clawAI.outputStyle": {
          "type": "string",
          "default": "default",
          "scope": "resource",
          "description": "%config.outputStyle%"
        },
        "clawAI.viewDensity": {
          "type": "string",
          "enum": [
            "full",
            "focus"
          ],
          "default": "full",
          "scope": "resource",
          "description": "%config.viewDensity%"
        },
        "clawAI.effortMode": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "MAX",
            "XHIGH",
            "ULTRA"
          ],
          "default": "ULTRA",
          "scope": "resource",
          "description": "%config.effortMode%"
        },
        "clawAI.speedMode": {
          "type": "string",
          "enum": [
            "1X",
            "1.5X",
            "2X"
          ],
          "default": "1X",
          "scope": "resource",
          "description": "%config.speedMode%"
        },
        "clawAI.permissionMode": {
          "type": "string",
          "enum": [
            "PLAN",
            "ASK",
            "AUTO_EDIT",
            "AUTONOMOUS_SCOPED",
            "ENTERPRISE_LOCKED"
          ],
          "default": "ASK",
          "scope": "resource",
          "description": "%config.permissionMode%"
        },
        "clawAI.selectedModel": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.selectedModel%"
        },
        "clawAI.autosave": {
          "type": "string",
          "enum": [
            "off",
            "before-edit"
          ],
          "default": "off",
          "scope": "resource",
          "description": "%config.autosave%"
        },
        "clawAI.maxContextBytes": {
          "type": "number",
          "default": 200000,
          "minimum": 1000,
          "maximum": 2000000,
          "scope": "resource",
          "description": "%config.maxContextBytes%"
        },
        "clawAI.maxContextFiles": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "maximum": 200,
          "scope": "resource",
          "description": "%config.maxContextFiles%"
        },
        "clawAI.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/coverage/**",
            "**/.env*",
            "**/*secret*",
            "**/*credential*"
          ],
          "scope": "resource",
          "description": "%config.exclude%"
        },
        "clawAI.historyLimit": {
          "type": "number",
          "default": 50,
          "minimum": 5,
          "maximum": 500,
          "scope": "window",
          "description": "%config.historyLimit%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clawAI",
          "title": "%view.container%",
          "icon": "resources/claw.svg"
        }
      ]
    },
    "views": {
      "clawAI": [
        {
          "id": "clawAI.chat",
          "type": "webview",
          "name": "%view.chat%",
          "contextualTitle": "%view.chatTitle%"
        },
        {
          "id": "clawAI.setup",
          "name": "%view.setup%",
          "when": "clawAI.setupIncomplete"
        },
        {
          "id": "clawAI.model",
          "name": "%view.model%"
        },
        {
          "id": "clawAI.context",
          "name": "%view.context%"
        },
        {
          "id": "clawAI.history",
          "name": "%view.history%"
        },
        {
          "id": "clawAI.tasks",
          "name": "%view.tasks%"
        },
        {
          "id": "clawAI.findings",
          "name": "%view.findings%"
        },
        {
          "id": "clawAI.artifacts",
          "name": "%view.artifacts%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "clawAI.model",
        "contents": "%welcome.model%\n[Select model](command:clawAI.selectModel)"
      },
      {
        "view": "clawAI.context",
        "contents": "%welcome.context%"
      },
      {
        "view": "clawAI.history",
        "contents": "%welcome.history%\n[Open chat](command:clawAI.openChat)"
      }
    ],
    "chatParticipants": [
      {
        "id": "clawai.coding-agent",
        "name": "clawai",
        "fullName": "ClawAI Coding Agent",
        "description": "Chat with ClawAI using your configured cloud and local models.",
        "isSticky": true
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "clawAI.askSelection",
          "group": "clawAI@1",
          "when": "editorHasSelection"
        },
        {
          "command": "clawAI.fixCode",
          "group": "clawAI@2",
          "when": "editorHasSelection && clawAI.workspaceTrusted"
        },
        {
          "command": "clawAI.reviewCode",
          "group": "clawAI@3",
          "when": "editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "clawAI.askFile",
          "group": "clawAI@1"
        }
      ],
      "view/title": [
        {
          "command": "clawAI.refreshModels",
          "when": "view == clawAI.model",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "clawAI.openChat",
          "group": "navigation@50"
        }
      ],
      "commandPalette": [
        {
          "command": "clawAI.fixCode",
          "when": "clawAI.workspaceTrusted"
        },
        {
          "command": "clawAI.generateCode",
          "when": "clawAI.workspaceTrusted"
        }
      ]
    },
    "keybindings": [
      {
        "command": "clawAI.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "clawAI.askSelection",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "clawAI.cancel",
        "key": "ctrl+alt+escape",
        "mac": "cmd+alt+escape"
      },
      {
        "command": "clawAI.undoLastEdit",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z"
      },
      {
        "command": "clawAI.toggleFocusView",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "clawAI.reopenClosedChat",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "clawAI.selectModel",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "clawAI.searchRunHistory",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      },
      {
        "command": "clawAI.reviewCode",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "clawAI.generateTests",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorTextFocus"
      },
      {
        "command": "clawAI.fixCode",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "/.clawai/policies/policy.json",
        "url": "./schemas/clawai-policy.schema.json"
      },
      {
        "fileMatch": "/.clawai/agents/agents.json",
        "url": "./schemas/clawai-agents.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:labs": "node --test tests/labs/*.test.mjs",
    "test:host": "npm run build && node scripts/run-extension-tests.mjs",
    "test:host:installed": "node scripts/run-installed-extension-tests.mjs",
    "test:playwright": "playwright test",
    "lab:bootstrap": "node scripts/labs/bootstrap-lab.mjs",
    "lab:release-parity": "node scripts/labs/verify-release-parity.mjs",
    "lab:score": "node scripts/labs/readiness-score.mjs",
    "coverage:scope": "node scripts/labs/verify-coverage-scope.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:audit": "node scripts/package-audit.mjs",
    "supply-chain": "node scripts/generate-supply-chain.mjs",
    "l10n:build": "node scripts/generate-locales.mjs",
    "l10n:verify": "node scripts/generate-locales.mjs && git diff --exit-code -- l10n package.nls.json package.nls.*.json",
    "package": "npm run build && node scripts/package-extension.mjs",
    "check": "npm run format:check && npm run l10n:verify && npm run lint && npm run typecheck && npm run scan:paths && npm run coverage:scope && npm test && npm run build && npm run package:audit",
    "scan:paths": "node scripts/scan-absolute-paths.mjs",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "chromium-bidi": "0.4.33",
    "cross-spawn": "^7.0.6",
    "jszip": "^3.10.1",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.98.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
